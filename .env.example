# Mẫu cấu hình. Copy thành file .env rồi điền giá trị thật.
DB_URL=jdbc:mysql://localhost:3306/ten_database?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=

# Có user/password: mongodb://user:password@localhost:27017/ten_database?authSource=admin
MONGODB_URI=mongodb://localhost:27017/ten_database

# Khóa ký JWT, tối thiểu 32 byte. Tạo bằng: openssl rand -base64 48
JWT_SECRET=

# File service account tải từ Firebase Console > Project settings > Service accounts.
# Trên Windows dùng dấu / trong đường dẫn, vì file .env coi dấu \ là ký tự escape.
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
